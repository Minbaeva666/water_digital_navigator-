# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/database-name"

# Frontend URLs
FRONTEND_URL="http://localhost:5173"
CLIENT_ORIGIN="http://localhost:5173"

# File Paths
PUBLIC_PDF_DIR="./public/assets/pdf"

# Node Environment
NODE_ENV=development

# LISA AI Configuration
LISA_API_TOKEN=sk-your-token-here
LISA_API_BASE=https://chat-1.ki-awz.iisys.de/
LLM_MODEL=your_model_name
USE_MOCK_LISA=false

# TLS Configuration (development only, set to 1 to disable certificate verification)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
ACCESS_SECRET=your-long-random-access-secret-here
REFRESH_SECRET=your-long-random-refresh-secret-here

# Email Configuration (Office 365)
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password-here
EMAIL_FROM="Digital Lotse Wasser <your-email@example.com>"
ADMIN_EMAIL=diginax.portal@hof-university.de
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_DEBUG=false