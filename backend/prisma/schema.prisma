// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"   // or "./ERD.png"
  // layout = "elk"         // optional: nicer auto-layout for bigger schemas
  // theme  = "light"       // optional
}


model PublicPdf {
  id String @id @default(cuid())

  singleton Int @unique @default(1)

  title        String
  description  String?  @db.Text
  filename     String // z.B. "public.pdf"
  path         String // z.B. "src/assets/pdf/public.pdf"
  mimeType     String // "application/pdf"
  size         Int // Bytes
  originalName String // Original-Dateiname
  uploadedAt   DateTime @default(now())

  uploadedById String?
  uploadedBy   User?   @relation("PdfUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  isPublic Boolean @default(true)

  @@index([uploadedAt])
}

model AccessibilityTerms {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String    @id @default(cuid())
  items     FaqItem[] @relation("FaqToItems")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FaqItem {
  id    String @id @default(cuid())
  faqId String
  faq   Faq    @relation("FaqToItems", fields: [faqId], references: [id], onDelete: Cascade)

  sort    Int    @default(0)
  header  String
  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([faqId, sort])
  @@index([faqId, sort])
}

model TermsOfUse {
  id        String   @id @default(cuid())
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedById String?
  updatedBy   User?   @relation("TermsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  acceptances UserTermsOfUseAcceptance[]

  @@index([updatedAt])
}

model UserTermsOfUseAcceptance {
  id         String   @id @default(cuid())
  userId     String
  termsId    String
  acceptedAt DateTime @default(now())
  ip         String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  terms TermsOfUse @relation(fields: [termsId], references: [id], onDelete: Cascade)

  @@unique([userId, termsId])
  @@index([userId, acceptedAt])
  @@index([termsId, acceptedAt])
}

model PrivacyPolicy {
  id        String   @id @default(cuid())
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedById String?
  updatedBy   User?   @relation("PrivacyPolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  acceptances UserPrivacyPolicyAcceptance[]

  @@index([updatedAt])
}

model UserPrivacyPolicyAcceptance {
  id              String   @id @default(cuid())
  userId          String
  privacyPolicyId String
  acceptedAt      DateTime @default(now())
  ip              String?  @db.VarChar(45)
  userAgent       String?  @db.VarChar(255)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  privacyPolicy PrivacyPolicy @relation(fields: [privacyPolicyId], references: [id], onDelete: Cascade)

  @@unique([userId, privacyPolicyId])
  @@index([userId, acceptedAt])
  @@index([privacyPolicyId, acceptedAt])
}

model AccessibilityStatement {
  id        String   @id @default(cuid())
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedById String?
  updatedBy   User?   @relation("AccessibilityUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model ImprintStatement {
  id        String   @id @default(cuid())
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedById String?
  updatedBy   User?   @relation("ImprintUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  password       String
  firstName      String
  lastName       String
  phonenumber    String?
  salutationType SalutationType
  title          String?
  role           Role           @default(USER)
  accountState   AccountState   @default(VERIFY_EMAIL)
  createdAt      DateTime       @default(now())
  createdById    String?
  createdBy      User?          @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers   User[]         @relation("UserCreatedBy")

  updatedAt                DateTime  @updatedAt
  emailVerifiedAt          DateTime?
  hasAcceptedTerms         Boolean   @default(false) // optionaler Schnellmarker
  hasAcceptedPrivacyPolicy Boolean   @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tokens Token[]

  digitalSolutions        DigitalSolution[] @relation("UserOwnsSolutions")
  digitalSolutionsCreated DigitalSolution[] @relation("SolutionCreatedBy")
  organizationsCreated    Organization[]    @relation("OrgCreatedBy")
  presentedSolutions      DigitalSolution[] @relation("SolutionPresentedBy")

  // Terms of Use
  termsAcceptances UserTermsOfUseAcceptance[]
  termsUpdated     TermsOfUse[]               @relation("TermsUpdatedBy")

  // Privacy Policy
  privacyPolicyAcceptances UserPrivacyPolicyAcceptance[]
  privacyPolicyUpdated     PrivacyPolicy[]               @relation("PrivacyPolicyUpdatedBy")

  // Accessibility
  accessibilityUpdated AccessibilityStatement[] @relation("AccessibilityUpdatedBy")

  // Imprint
  imprintUpdated ImprintStatement[] @relation("ImprintUpdatedBy")

  // Public PDF (Uploader-Relation)
  uploadedPdfs PublicPdf[] @relation("PdfUploadedBy")

  @@index([organizationId])
}

enum PublishedByType {
  OWNER
  ADMIN
  WEB
  PUBLICATION
}

model Organization {
  id          String   @id @default(cuid())
  email       String?  @unique
  name        String   @unique
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("OrgCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  street String?
  zip    String
  city   String?

  // Country → Relation
  countryId String
  country   Country @relation(fields: [countryId], references: [code], onDelete: Restrict)

  // Region → Relation (optional)
  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  municipalityProfile MunicipalityProfile?
  organizationType    OrganizationType?
  organizationState   OrganizationState
  website             String?
  logoBase64          String?              @db.LongText
  logoMimeType        String?
  logoFilename        String?

  users        User[]
  manualCoords Boolean? @default(false)
  lat          Float?
  lon          Float?

  digitalSolutions DigitalSolution[] @relation("OrganizationOwnsSolutions")
  projectPartners  DigitalSolution[] @relation("ProjectPartnerToDigitalSolutions")
  solutionUsers    DigitalSolution[] @relation("SolutionUsersToDigitalSolutions")

  @@index([countryId])
  @@index([regionId])
}

model MunicipalityProfile {
  /// Gleiche ID wie Organization = echte 1:1-Beziehung
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Einwohnerzahl (nicht-negativ)
  population     Int          @db.UnsignedInt

  @@index([population])
}

model DigitalSolution {
  id                         String               @id @default(cuid())
  name                       String?
  link                       String?
  maturityDegree             MaturityDegree?
  offeringCategory           OfferingCategory?
  shortDescription           String?              @db.Text
  longDescription            String?              @db.Text
  goalDescription            String?              @db.Text
  technicalDescription       String?              @db.Text
  efficiencyDescription      String?              @db.Text
  processDescription         String?              @db.Text
  socialRelevanceDescription String?              @db.Text
  hasAcceptedTerms           Boolean              @default(false)
  hasAcceptedPrivacyPolicy   Boolean              @default(false)
  presentedByUserId          String?
  presentedByUser            User?                @relation("SolutionPresentedBy", fields: [presentedByUserId], references: [id], onDelete: SetNull)
  solutionPresentedByUser    Boolean?
  state                      DigitalSolutionState @default(REQUESTED)
  createdAt                  DateTime             @default(now())
  createdAtOverride          DateTime             @default(now())
  createdById                String?
  createdBy                  User?                @relation("SolutionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  readyForOperation          DateTime?
  images                     Image[]              @relation("DigitalSolutionImages")

  // Ownership durch Organisation
  organizationId String?
  organization   Organization? @relation("OrganizationOwnsSolutions", fields: [organizationId], references: [id], onDelete: Restrict)

  // Ownership durch User
  userId String?
  user   User?   @relation("UserOwnsSolutions", fields: [userId], references: [id], onDelete: Restrict)

  // Partnerships (Many‐to‐Many)
  projectPartners Organization[] @relation("ProjectPartnerToDigitalSolutions")

  // Nutzung durch Organisationen (Many‐to‐Many)
  solutionUsers Organization[] @relation("SolutionUsersToDigitalSolutions")

  // Minimal: Wer/wie wurde veröffentlicht?
  publishedBy     PublishedByType?
  publishedAt     DateTime?
  publishedSource String?          @db.VarChar(2048)

  taxonomyNodes DigitalSolutionTaxonomy[]

  @@index([organizationId])
  @@index([userId])
  @@index([publishedAt])
}

model TaxonomyNode {
  id       String         @id @default(cuid())
  parentId String?
  parent   TaxonomyNode?  @relation("TaxonomyParent", fields: [parentId], references: [id], onDelete: SetNull)
  children TaxonomyNode[] @relation("TaxonomyParent")

  // z.B. "aufgabenbereich" | "anwendungsbereich" | weitere Facetten
  type String @db.VarChar(64)

  slug   String  @db.VarChar(191)
  nameDe String  @db.VarChar(255)
  nameEn String? @db.VarChar(255)

  // Materialized Path, z.B. "/aufgabenbereich/planung/kapazitaetsplanung"
  path  String @db.VarChar(768)
  depth Int
  sort  Int    @default(0)

  isFav              Boolean @default(false)
  color              String?
  maxSelectableNodes Int?
  minSelectableNodes Int?

  solutions DigitalSolutionTaxonomy[]

  @@unique([slug])
  @@unique([path])
  @@index([path])
  @@index([depth])
  @@index([type, depth, sort])
}

model DigitalSolutionTaxonomy {
  digitalSolutionId String
  taxonomyNodeId    String

  digitalSolution DigitalSolution @relation(fields: [digitalSolutionId], references: [id], onDelete: Cascade)
  taxonomyNode    TaxonomyNode    @relation(fields: [taxonomyNodeId], references: [id], onDelete: Cascade)

  @@id([digitalSolutionId, taxonomyNodeId])
  @@index([taxonomyNodeId])
  @@index([digitalSolutionId])
}

enum DigitalSolutionState {
  DRAFT
  REQUESTED
  ACTIVATED
  DEACTIVATED
}

model Image {
  id                String          @id @default(cuid())
  filename          String
  path              String          @db.Text
  mimeType          String
  size              Int
  uploadedAt        DateTime        @default(now())
  contentHash       String?         @db.Char(64)
  type              ImageType
  digitalSolutionId String
  digitalSolution   DigitalSolution @relation("DigitalSolutionImages", fields: [digitalSolutionId], references: [id], onDelete: Cascade)
}

enum ImageType {
  TITLE
  DETAIL
}

model Country {
  code   String  @id @db.VarChar(2) // ISO 3166-1 Alpha-2, z.B. "DE", "AT"
  nameDe String
  nameEn String?

  // Relationen
  organizations Organization[]
  regions       Region[]
}

model Region {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [code], onDelete: Cascade)

  code       String  @db.VarChar(16) // ISO 3166-2 z. B. DE-BY, AT-9
  nameDe     String
  nameEn     String?
  adminLevel Int     @default(1) // 1 = Bundesland/Kanton/State

  organizations Organization[]

  @@unique([countryId, code])
  @@index([countryId])
}

enum PresentedBy {
  ORGANIZATION
  USER
}

enum SolutionCategoryState {
  PENDING
  APPROVED
  REJECTED
}

model Token {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.Char(64)
  tokenType TokenType
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
  @@index([expiresAt])
}

enum SalutationType {
  MR // Mann
  MS // Frau
  MX // Divers
  PREFER_NOT_TO_SAY
}

enum MaturityDegree {
  DEVELOPMENT_DEMONSTRATION_PHASE // Entwicklungs-,Demonstrationsphase
  IDEA_CONCEPT_STUDY // Idee,Konzept,Studie
  MARKET_READY_CONTINUOUS_OPERATION // Marktreif,Dauerbetrieb
  TEST_PHASE_PROTOTYPE // Testphase,Prototyp
}

enum OfferingCategory {
  SERVICE // Dienstleistung
  RESEARCH // Forschung
  COMPLETE_SOLUTION // Komplettlösung
  PRODUCT // Produkt
  PROJECT // Projekt
  IMPLEMENTATION_ROADMAP // Umsetzungsfahrplan
}

enum TokenType {
  REGISTRATION_SUCCESSFUL_TOKEN
  REFRESH_TOKEN
  PASSWORD_RESET_TOKEN
  EMAIL_VERIFICATION_TOKEN
  REVOKE_REGISTRATION_TOKEN
  REVOKE_REGISTRATION_SUCCESSFUL_TOKEN
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum AccountState {
  VERIFY_EMAIL
  REGISTERED
  REGISTRATION_REVOKED
}

enum OrganizationState {
  LITE //Anwenderorganisation/Projektpartner
  FULL
}

enum OrganizationType {
  INDUSTRY // Industrie
  CRAFT // Handwerk
  STARTUP // Start-Up
  COLLEGE_UNIVERSITY // Hochschule / Universität
  RESEARCH_INSTITUTE // außeruniversitäres Forschungsinstitut
  MUNICIPALITY // Kommune
  MUNICIPAL_ORGANIZATION // kommunale Organisation
  ASSOCIATION // Verband/Verein
  SME // KMU
}
