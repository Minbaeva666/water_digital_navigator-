{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node --files\" src/index.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test-db": "ts-node scripts/test-db.ts",
    "setup": "ts-node src/scripts/setup.ts",
    "prisma generate": "npx prisma generate",
    "prisma push": "npx prisma db push",
    "build": "tsc",
    "prod": "npm run build && npm run start",
    "seed:taxonomy": "ts-node -r dotenv/config --transpile-only src/prisma/seed/seed.taxonomy.ts",
    "seed:faq": "ts-node -r dotenv/config --transpile-only src/prisma/seed/seed.faq.ts",
    "seed:digital-solution": "ts-node -r dotenv/config --transpile-only src/prisma/seed/seed.digitalSolution.ts",
    "seed:admin": "ts-node -r dotenv/config --transpile-only src/prisma/seed/seed.admin.ts",
    "seed:moderator": "ts-node -r dotenv/config --transpile-only src/prisma/seed/seed.moderator.ts",
    "seed:testuser": "ts-node -r dotenv/config --transpile-only src/prisma/seed/seed.testuser.ts",
    "seed:countries": "ts-node -r dotenv/config --transpile-only src/prisma/seed/seed.countries.ts",
    "migrate:org-coordinates": "ts-node -r dotenv/config --transpile-only scripts/regenerate-org-coordinates.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "6.4.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "sharp": "^0.34.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "dependency-cruiser": "^17.1.0",
    "madge": "^8.0.0",
    "nodemon": "^3.1.9",
    "prisma": "6.4.1",
    "prisma-erd-generator": "^2.1.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.14",
    "typedoc-umlclass": "^0.10.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  }
}
